<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Somente leitura, concedidas na instalação (permissões "normais"): estado do Wi-Fi e
        do Bluetooth para os indicadores da Home. Continua SEM permissão de internet.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Usada somente por "Salvar em Download" no Android 9 ou anterior. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
        Player próprio (etapa 0.4.0): leitura das músicas do pendrive, pedida ao usuário na aba
        Música (até o Android 12 é "armazenamento"; no 13+, só "áudio").
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
        Serviço de reprodução em primeiro plano, só enquanto a música toca. Permissões
        "normais", concedidas na instalação; exigidas a partir do Android 9 e 14 (a central
        roda o 8.1, que não as usa).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
        Notificação "tocando agora": só existe a partir do Android 13 e não é pedida ao
        usuário (sem ela, a música toca do mesmo jeito; a notificação fica oculta).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11+: declara exatamente o que o diagnóstico consulta, sem pedir
        acesso a todos os pacotes (QUERY_ALL_PACKAGES).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
        <intent>
            <action android:name="android.settings.SECURITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".app.NyxCarApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NyxCar">

        <!--
            Launcher (Views): Home e abas.
            Etapa 0.4.0: declara CATEGORY_HOME, ou seja, PODE ser escolhido como tela inicial.
            Quem escolhe é o usuário (Apps padrão → Tela inicial, ou "Sempre" ao tocar em Home);
            o app não muda essa configuração. O launcher original continua instalado e a
            volta está no BUILD.md, seção 8. Mantém o ícone comum (LAUNCHER).
            singleTask: uma só Home aberta; o botão Home chega por onNewIntent.
        -->
        <activity
            android:name=".app.MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Player próprio: mantém a música tocando com a tela de outro app aberta. Existe só
            enquanto há música tocando (notificação obrigatória do Android); não é exportado.
        -->
        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Ferramenta de diagnóstico (Compose), com ícone e tarefa próprios para
            não se misturar com a Home na tela de Recentes.
        -->
        <activity
            android:name=".diagnostics.ui.DiagnosticsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:label="@string/app_name_diagnostics"
            android:taskAffinity="com.premiumcar.launcher.diagnostics">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Só para o teste de sessões de mídia do Nyx Diagnóstico. Fica inerte até o usuário
            ativar "Nyx Car" em Acesso a notificações; não lê notificações.
        -->
        <service
            android:name=".diagnostics.cartest.MediaAccessListenerService"
            android:exported="true"
            android:label="@string/media_access_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Catálogo do Design System, aberto pelo Diagnóstico. -->
        <activity
            android:name=".ui.catalog.DesignCatalogActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:label="@string/design_catalog" />

        <!-- Testes de fluidez: cada motor roda em um processo próprio (partida a frio). -->
        <activity
            android:name=".perf.ComposeBenchmarkActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/benchmark_compose"
            android:process=":bench_compose" />

        <activity
            android:name=".perf.ViewBenchmarkActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/benchmark_views"
            android:process=":bench_views" />
    </application>

</manifest>
