<?xml version="1.0" encoding="utf-8"?>
<!--
    Estrutura comum das abas (Música, Aplicativos, Conectividade, Configurações):
    título e corpo. O corpo é montado em código (ui/screens/ScreenBuilder): linhas de
    atalhos e cartões dividem a altura disponível por peso, sem rolagem.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/pc_screen_margin">

    <TextView
        android:id="@+id/screen_title"
        style="@style/PcText.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/screen_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/pc_space_m"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
