<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão informativo (não tocável): título e linhas de texto preenchidas em código. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pc_bg_card"
    android:orientation="vertical"
    android:padding="@dimen/pc_card_padding">

    <TextView
        android:id="@+id/info_title"
        style="@style/PcText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/info_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
