<?xml version="1.0" encoding="utf-8"?>
<!--
    Aba Aplicativos (0.4.4): título, botões da edição e o seletor "Favoritos | Todos"; abaixo, as
    duas páginas. "Favoritos" é a grade dos 12 favoritos; "Todos" é a lista de apps da central,
    com os mesmos atalhos (4 colunas, 3 linhas por tela) e barra de rolagem. Na edição, a mesma
    grade e a mesma lista servem para trocar um favorito (ui/apps/AppsScreen).

    As margens laterais ficam dentro de cada página (não no layout todo) para a barra de rolagem
    de "Todos" ocupar a margem direita sem estreitar os atalhos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="@dimen/pc_screen_margin"
    android:paddingBottom="@dimen/pc_screen_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pc_screen_margin"
        android:paddingEnd="@dimen/pc_screen_margin">

        <TextView
            android:id="@+id/screen_title"
            style="@style/PcText.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_apps" />

        <ImageButton
            android:id="@+id/apps_edit"
            android:layout_width="@dimen/pc_touch_min"
            android:layout_height="@dimen/pc_touch_min"
            android:layout_marginEnd="@dimen/pc_space_m"
            android:background="@drawable/pc_bg_button"
            android:contentDescription="@string/apps_edit_title"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit"
            android:tint="@color/pc_content_accent" />

        <Button
            android:id="@+id/apps_restore"
            style="@style/PcButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/pc_space_m"
            android:text="@string/apps_restore"
            android:visibility="gone" />

        <Button
            android:id="@+id/apps_done"
            style="@style/PcButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apps_done"
            android:visibility="gone" />

        <Button
            android:id="@+id/apps_cancel"
            style="@style/PcButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apps_cancel"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/apps_selector"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/pc_touch_min"
            android:background="@drawable/pc_bg_segmented"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/apps_tab_favorites"
                style="@style/PcText.Label"
                android:layout_width="@dimen/pc_segment_width"
                android:layout_height="match_parent"
                android:background="@drawable/pc_bg_segment"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/apps_tab_favorites"
                android:textColor="@color/pc_nav_content" />

            <TextView
                android:id="@+id/apps_tab_all"
                style="@style/PcText.Label"
                android:layout_width="@dimen/pc_segment_width"
                android:layout_height="match_parent"
                android:background="@drawable/pc_bg_segment"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/apps_tab_all"
                android:textColor="@color/pc_nav_content" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/apps_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/pc_space_m"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/apps_favorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/pc_screen_margin"
            android:paddingEnd="@dimen/pc_screen_margin" />

        <!-- Barra de rolagem sempre visível (quando há o que rolar), na margem direita. -->
        <ScrollView
            android:id="@+id/apps_all"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/pc_screen_margin"
            android:paddingEnd="@dimen/pc_screen_margin"
            android:scrollbarSize="@dimen/pc_screen_margin"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/pc_scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/pc_scrollbar_track"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/apps_all_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
