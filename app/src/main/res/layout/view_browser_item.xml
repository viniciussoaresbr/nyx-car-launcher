<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da lista de pastas e músicas (64 dp: alvo de toque mínimo). Preenchida em BrowserAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/pc_touch_min"
    android:background="@drawable/pc_bg_list_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pc_space_m"
    android:paddingEnd="@dimen/pc_space_m">

    <ImageView
        android:id="@+id/item_icon"
        android:layout_width="@dimen/pc_icon_s"
        android:layout_height="@dimen/pc_icon_s"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/item_name"
        style="@style/PcText.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pc_space_m"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true" />

    <ImageView
        android:id="@+id/item_trailing"
        android:layout_width="@dimen/pc_icon_s"
        android:layout_height="@dimen/pc_icon_s"
        android:layout_marginStart="@dimen/pc_space_s"
        android:importantForAccessibility="no" />
</LinearLayout>
