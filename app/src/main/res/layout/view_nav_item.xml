<?xml version="1.0" encoding="utf-8"?>
<!--
    Item da barra inferior, só com ícone (o nome do destino vai em contentDescription).
    A seleção (setSelected) chega aos filhos: a pílula aparece e o ícone fica em destaque.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/pc_bg_nav_item"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/nav_indicator"
        android:layout_width="@dimen/pc_nav_indicator_width"
        android:layout_height="@dimen/pc_nav_indicator_height"
        android:layout_gravity="center"
        android:background="@drawable/pc_nav_indicator">

        <ImageView
            android:id="@+id/nav_icon"
            android:layout_width="@dimen/pc_icon_m"
            android:layout_height="@dimen/pc_icon_m"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/pc_nav_content" />
    </FrameLayout>
</FrameLayout>
