<?xml version="1.0" encoding="utf-8"?>
<!-- Botão secundário. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface" />
            <corners android:radius="@dimen/pc_radius_m" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface_highest" />
            <corners android:radius="@dimen/pc_radius_m" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface_high" />
            <corners android:radius="@dimen/pc_radius_m" />
        </shape>
    </item>
</selector>
