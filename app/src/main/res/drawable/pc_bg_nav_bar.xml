<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior: superfície com linha divisória de 1 dp no topo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_outline" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface" />
        </shape>
    </item>
</layer-list>
