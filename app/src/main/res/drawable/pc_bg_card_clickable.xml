<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão tocável: escurece levemente ao pressionar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface_high" />
            <stroke android:width="1dp" android:color="@color/pc_outline" />
            <corners android:radius="@dimen/pc_radius_l" />
        </shape>
    </item>
    <item android:drawable="@drawable/pc_bg_card" />
</selector>
