<?xml version="1.0" encoding="utf-8"?>
<!-- Atalho: normal, pressionado, selecionado (borda de destaque) e desativado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface" />
            <corners android:radius="@dimen/pc_radius_l" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface_highest" />
            <corners android:radius="@dimen/pc_radius_l" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface_high" />
            <stroke android:width="2dp" android:color="@color/pc_accent" />
            <corners android:radius="@dimen/pc_radius_l" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_surface_high" />
            <corners android:radius="@dimen/pc_radius_l" />
        </shape>
    </item>
</selector>
